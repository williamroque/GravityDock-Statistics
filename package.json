{
  "name": "@gravitydock/statistics",
  "version": "1.0.0",
  "description": "Gravity Dock Statistics package",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=iife --global-name=__GravityDock_Package",
    "build:gdpkg": "npm run build && node scripts/build-gdpkg.js",
    "dev": "npm run build -- --watch"
  },
  "devDependencies": {
    "@gravitydock/types": "file:../types",
    "adm-zip": "^0.5.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "arquero": "^5.4.1",
    "jstat": "^1.9.6",
    "ml-regression": "^5.0.0",
    "simple-statistics": "^7.8.3"
  }
}
